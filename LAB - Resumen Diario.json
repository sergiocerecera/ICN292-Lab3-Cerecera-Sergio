      "name": "Summarize"
    },
    {
      "parameters": {
        "jsCode": "const datos = $input.all();\n\nlet totalSolicitudes = 0;\nlet totalMonto = 0;\nlet aprobaciones = 0;\nlet resumen = [];\n\nfor (const item of datos) {\n  const ruta = item.json.ruta;\n  const cantidad = Number(item.json.count_id_solicitud || 0);\n  const monto = Number(item.json.sum_monto || 0);\n\n  totalSolicitudes += cantidad;\n  totalMonto += monto;\n\n  if (ruta === 'APROBACION') {\n    aprobaciones = cantidad;\n  }\n\n  resumen.push(\n    `${ruta}: ${cantidad} solicitudes - $${monto.toLocaleString('es-CL')}`\n  );\n}\n\nconst tasaAprobacion = totalSolicitudes > 0\n  ? ((aprobaciones / totalSolicitudes) * 100).toFixed(2)\n  : '0.00';\n\nreturn [{\n  json: {\n    asunto: 'Resumen diario de devoluciones',\n    resumen: resumen.join('\\n'),\n    totalSolicitudes,\n    totalMonto,\n    tasaAprobacion: `${tasaAprobacion}%`,\n    mensaje:\n`Resumen diario de devoluciones\n\n${resumen.join('\\n')}\n\nTotal de solicitudes: ${totalSolicitudes}\nMonto total del día: $${totalMonto.toLocaleString('es-CL')}\nTasa de aprobación automática: ${tasaAprobacion}%`\n  }\n}];"
      },
